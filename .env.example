# Copy this file to .env.local for local `vercel dev` testing.
# In production, set this in Vercel: Project Settings → Environment Variables.
# Get a key from platform.openai.com — Settings → Billing supports GBP invoicing
# for UK accounts (OpenAI's multicurrency billing), which is why this project
# uses OpenAI instead of a USD-only provider.
OPENAI_API_KEY=sk-...
